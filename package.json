{
  "name": "@mirror/core",
  "version": "0.1.0",
  "description": "The portable, headless agentic core SDK powering the Mirror ecosystem.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "node init && tsup",
    "dev": "node init && tsup --watch",
    "test": "vitest run",
    "lint": "eslint src/"
  },
  "dependencies": {
    "diff": "^7.0.0",
    "fast-glob": "^3.3.2",
    "zod": "^3.25.76",
    "events": "^3.3.0"
  },
  "devDependencies": {
    "@types/diff": "^7.0.0",
    "@types/node": "^24.1.0",
    "tsup": "^8.4.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  }
}
